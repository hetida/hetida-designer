{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Spring Boot-HetidaDesignerBackendApplication<backend>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "mainClass": "org.hetida.designer.backend.HetidaDesignerBackendApplication",
            "projectName": "backend",
            "args": "--spring.profiles.active=local",
        }
    ]
}