#!/usr/bin/env bash

usage() {
    echo "$0 [COMMAND] [ARGS]"
    echo ""
    echo "Hint: Commands often expect a Python dev virtual environment to be active"
    echo ""
    echo "  Commands:"
    echo "  - deps:upgrade    :    resolves and locks Python dependencies, upgrading them all"
    echo "  - deps:sync       :    syncs currently activated virtual environment with locked Python dev dependencies."
    echo "  - shell           :    Activate virtual environment, thereby creating and syncing if necessary"
    echo "  - test            :    run pytest on hetdesrun code, passing ARGS on to pytest."
    echo "                         --extended also runs the tests which do not run by default"
    echo "                         (performance, executing all base transformations)"
    echo "  - comptest        :    run pytest base component tests"
    echo "  - lint            :    call ruff"
    echo "  - typecheck       :    run mypy static type check"
    echo "  - format          :    run ruff format"
    echo "  - seccheck        :    run bandit security checks"
    echo "  - check           :    run format check, tests, typechecking."
    echo "                         --extended runs the tests as test --extended does"
}

fn_exists() {
    LC_ALL=C type "${1:-}" 2>/dev/null | grep -q 'function'
}

COMMAND="${1:-}"
shift
ARGUMENTS=("${@}")

set -euo pipefail

#----- subcommands -----#

deps:upgrade() {
    # upgrade and lock including dev-dependencies
    ./pipt upgrade
}

deps:sync() {
    # sync dev dependencies
    ./pipt sync
}

shell() {
    ./pipt shell
}

test() {
    python -m pytest --cov=hetdesrun --no-cov-on-fail --cov-report=term-missing tests "$@"
}

comptest() {
    python -m pytest --doctest-modules --cov=transformations/components --cov-report=term-missing transformations/components/*/*.py "$@" 
}

lint() {
    ruff check hetdesrun transformations/components tests "${@}"
}

imsort() {
    ruff check --select I hetdesrun transformations/components tests --fix "${@}"
}

typecheck() {
    python3 -m mypy "${@}" hetdesrun
}

format() {
    ruff check --select I hetdesrun transformations/components tests --fix "${@}" && echo "--> Ruff import sorting run."
    ruff format hetdesrun transformations/components tests "${@}" && echo "--> ruff format run."
}

seccheck() {
    bandit -r hetdesrun --skip B101
}

check() {
    # Will fail with non-zero exit status if any tool has some complaint.
    # If everything is okay this will have 0 exits status
    local test_options=()
    for arg in "$@"; do
        case "$arg" in
        --extended) test_options+=(--extended) ;;
        *) echo "Unknown option for check: $arg" >&2 && return 1 ;;
        esac
    done

    echo "--> Running ruff format in check mode" && ruff format hetdesrun transformations/components tests --check &&
        echo "--> Running tests" && python -m pytest --cov=hetdesrun --cov-report=term-missing tests "${test_options[@]}" &&
        echo "--> Running base component tests" &&  python -m pytest --doctest-modules --cov=transformations/components --cov-report=term-missing transformations/components/*/*.py &&
        echo "--> Running mypy" && mypy hetdesrun &&
        echo "--> Running ruff" && ruff check hetdesrun transformations/components tests &&
        echo "--> Running bandit" && bandit -r hetdesrun --skip B101 &&
        echo "CHECKS EXECUTION RESULTS: All checks were successful!"
}

#----- Execution -----#

if fn_exists "$COMMAND"; then
    # cd into the script's current directory
    cd "${0%/*}" || exit 1

    # Execute
    TIMEFORMAT=$'\nTask completed in %3lR'

    time "$COMMAND" "${ARGUMENTS[@]}"
else
    usage
fi
