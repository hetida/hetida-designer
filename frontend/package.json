{
  "name": "hetida-designer-frontend",
  "description": "Hetida Designer Frontend",
  "version": "0.1.0",
  "homepage": "https://fuseki.com/data-science/hetida-designer/",
  "license": "MIT",
  "engines": {
    "node": "22.23.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hetida/hetida-designer"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test-docker": "ng test --karma-config ./src/karma-docker.conf.js",
    "lint": "ng lint",
    "format:all": "prettier --write \"src/**/*.{js,ts,json,html,scss}\"",
    "format:staged": "pretty-quick --staged --pattern \"frontend/**\"",
    "e2e-all": "playwright test --config=./playwright/playwright.config.ts",
    "e2e-chromium": "playwright test --config=./playwright/playwright.config.ts --project=chromium",
    "test-headless": "ng test --watch=false --browsers=ChromeHeadless",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.30",
    "@angular/cdk": "20.2.14",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/forms": "^20.3.30",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "^20.3.30",
    "@angular/router": "^20.3.30",
    "@danielmoncada/angular-datetime-picker": "20.0.1",
    "@danielmoncada/angular-datetime-picker-moment-adapter": "7.0.1",
    "@ngrx/entity": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "angular-auth-oidc-client": "20.0.3",
    "angular-plotly.js": "^6.0.0",
    "base64-js": "^1.5.1",
    "guid-typescript": "^1.0.9",
    "js-sha256": "1.0.0",
    "katex": "0.18.4",
    "marked": "18.0.10",
    "material-design-icons-iconfont": "^6.7.0",
    "moment": "^2.30.1",
    "monaco-editor": "^0.52.2",
    "ngx-monaco-editor-v2": "20.3.0",
    "plotly.js": "^3.0.1",
    "plotly.js-locales": "3.7.0",
    "rxjs": "^7.8.2",
    "uuid": "14.0.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
