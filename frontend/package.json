    "husky": "^9.1.7",
    "jasmine-core": "6.3.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ng-packagr": "^20.3.2",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true,
