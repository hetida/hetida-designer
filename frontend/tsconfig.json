{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@models/*": ["src/app/models/*"],
      "hetida-flowchart": ["src/libs/hetida-flowchart/hetida-flowchart.ts"],
      "hetida-flowchart/*": ["src/libs/hetida-flowchart/*"],
      "ng-hetida-flowchart": ["src/libs/ng-hetida-flowchart/public-api.ts"],
      "hd-wiring": ["src/libs/hd-wiring/public-api.ts"],
      "hd-wiring/*": ["src/libs/hd-wiring/*"]
    },
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "importHelpers": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noUnusedParameters": true,
    "target": "ES2022",
    "typeRoots": ["node_modules/@types", "types"],
    "lib": ["es2018", "dom", "dom.iterable"],
    "useDefineForClassFields": false
  }
}
